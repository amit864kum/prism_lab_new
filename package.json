{
  "name": "prism-lab-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node --require ./scripts/mongo-dns-bootstrap.cjs ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "audit:production": "npm audit --omit=dev",
    "release:verify": "npm run verify && npm run migrate:storage:dry-run && npm run audit:production",
    "init-admin": "tsx scripts/init-admin.ts",
    "migrate:profile-publications": "tsx scripts/migrate-profile-publications.ts",
    "migrate:members": "tsx scripts/migrate-members.ts",
    "migrate:storage": "tsx scripts/migrate-storage.ts",
    "migrate:storage:dry-run": "tsx scripts/migrate-storage.ts",
    "migrate:publication-orders": "tsx scripts/migrate-publication-orders.ts",
    "sync:research-area-publications": "tsx scripts/sync-research-area-publications.ts",
    "rehearse:staging": "tsx scripts/staging-rehearsal.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "isomorphic-dompurify": "^3.3.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.6.3",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "fast-check": "^4.8.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
