# Application directory used by PM2 and operational scripts.
PRISM_APP_DIR=/srv/prism-lab/current
PORT=3000
PRISM_BIND_ADDRESS=127.0.0.1
UPLOADS_ROOT=/srv/prism-lab/shared/uploads
LOGS_ROOT=/srv/prism-lab/shared/logs

# Required application secrets. Supply real values through the deployment
# secret manager; never commit a populated copy of this file.
MONGODB_URI=mongodb://database-host:27017/prism-lab
# Normally unset in production; configure only when approved host DNS cannot
# resolve MongoDB SRV records.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-at-least-32-random-characters

# Canonical public origin.
NEXT_PUBLIC_API_URL=https://prismlab.iitp.ac.in
NEXT_PUBLIC_BASE_URL=https://prismlab.iitp.ac.in

# Backup tooling. BACKUP_ROOT must be durable storage outside the release tree.
BACKUP_ROOT=/srv/backups/prism-lab
BACKUP_SIGNING_PRIVATE_KEY=/etc/prism-lab-backup-signing.pem
BACKUP_SIGNING_PUBLIC_KEY=/etc/prism-lab-backup-signing.pub.pem
